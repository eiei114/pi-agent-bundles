{
  "name": "pi-agent-bundles",
  "version": "0.11.1",
  "private": true,
  "description": "Git-distributed Pi agent bundles for Multica and project-specific runtime defaults.",
  "type": "module",
  "license": "MIT",
  "author": "Keisu",
  "keywords": [
    "pi-package",
    "pi",
    "agent-bundle",
    "multica",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiei114/pi-agent-bundles.git"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-agent-bundles/issues"
  },
  "homepage": "https://github.com/eiei114/pi-agent-bundles#readme",
  "files": [
    "shared/",
    "bundles/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check:cursor-deps": "node scripts/check-cursor-dependency-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "ci": "npm run check:cursor-deps && npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./shared/extensions/agent-bundle-loader.ts"
    ],
    "skills": []
  },
  "dependencies": {
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.7.0",
    "@cursor/sdk": "1.2.0",
    "@howaboua/pi-codex-conversion": "^4.0.7",
    "@rahularya01/pi-cursor": "1.4.39",
    "pi-cursor-embedded-compat": "0.2.4",
    "pi-cursor-sdk": "0.5.7",
    "pi-fff": "^0.1.14",
    "pi-fff-non-ascii-guard": "^0.1.20",
    "pi-mcp-adapter": "^7.0.0",
    "pi-model-fallback": "0.5.11",
    "pi-multica-spine": "^0.12.19",
    "pi-smart-fetch": "^0.3.23"
  },
  "bundledDependencies": [
    "@bufbuild/protobuf",
    "@connectrpc/connect",
    "@cursor/sdk",
    "@howaboua/pi-codex-conversion",
    "@rahularya01/pi-cursor",
    "pi-cursor-embedded-compat",
    "pi-cursor-sdk",
    "pi-fff",
    "pi-fff-non-ascii-guard",
    "pi-mcp-adapter",
    "pi-multica-spine",
    "pi-smart-fetch"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1",
    "@types/node": "^26.6.6",
    "typebox": "latest",
    "typescript": "7.0.2"
  },
  "bundleDependencies": [
    "@bufbuild/protobuf",
    "@connectrpc/connect",
    "@cursor/sdk",
    "@howaboua/pi-codex-conversion",
    "@rahularya01/pi-cursor",
    "pi-cursor-embedded-compat",
    "pi-cursor-sdk",
    "pi-fff",
    "pi-fff-non-ascii-guard",
    "pi-mcp-adapter",
    "pi-multica-spine",
    "pi-smart-fetch"
  ]
}
